# Normalize line endings so diffs only show real changes (no CRLF/LF noise).
* text=auto eol=lf

# Explicit LF for all text we edit (avoids auto-detection gaps)
*.java text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Keep script line endings for Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
